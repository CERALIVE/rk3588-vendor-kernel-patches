+			 * audio_ready from inside hdmi_codec_startup(), which
+			 * holds hcp->lock - and plugged_cb() below takes that
+			 * same hcp->lock. Completing first means the waiter is
+			 * released without this work having to acquire a lock
+			 * the waiter itself is holding.
+			 */
+			WRITE_ONCE(hdmirx_dev->audio_present, true);
+			complete_all(&hdmirx_dev->audio_ready);
 			hdmirx_audio_handle_plugged_change(hdmirx_dev, 1);
 			process_audio_change(hdmirx_dev);
-			hdmirx_dev->audio_present = true;
 		}
 		delay = hdmirx_audio_clk_adjust(hdmirx_dev, cur_state - init_state,
 						cur_state - pre_state);
 	} else {
 		if (hdmirx_dev->audio_present) {
 			dev_info(hdmirx_dev->dev, "audio off");
+			WRITE_ONCE(hdmirx_dev->audio_present, false);
 			hdmirx_audio_handle_plugged_change(hdmirx_dev, 0);
 			process_audio_change(hdmirx_dev);
-			hdmirx_dev->audio_present = false;
 		}
 	}
 	as->pre_state = cur_state;
@@ -3880,6 +4046,7 @@ static void hdmirx_delayed_work_res_change(struct work_struct *work)
 			hdmirx_dma_config(hdmirx_dev);
 			hdmirx_interrupts_setup(hdmirx_dev, true);
 			hdmirx_audio_handle_plugged_change(hdmirx_dev, 1);
+			hdmirx_audio_set_state(hdmirx_dev, AUDIO_ON);
 		}
 	}
 	mutex_unlock(&hdmirx_dev->work_lock);
@@ -4162,7 +4329,7 @@ static int hdmirx_runtime_suspend(struct device *dev)
 
 	cancel_delayed_work_sync(&hdmirx_dev->delayed_work_hotplug);
 	cancel_delayed_work_sync(&hdmirx_dev->delayed_work_res_change);
-	cancel_delayed_work_sync(&hdmirx_dev->delayed_work_audio);
+	hdmirx_audio_disarm_work(hdmirx_dev);
 	cancel_delayed_work_sync(&hdmirx_dev->delayed_work_heartbeat);
