# kernel-pin.env — the exact upstream coordinates this patch series is built against.
#
# Every value here was READ OUT of a specific upstream revision (recorded below),
# never assumed. Re-resolve with `scripts/preflight.sh` before changing anything.
# Consumed by scripts/apply.sh, scripts/build-series.py,
# scripts/verify-payload-parity.py, the patch-apply CI workflow, and (downstream)
# a future image-building-pipeline vendor-kernel-build-from-source stage.
#
# shellcheck shell=bash
# shellcheck disable=SC2034  # pure data file; every value is consumed by a sourcing caller

# ---------------------------------------------------------------------------
# Armbian build framework — the revision the mapping below was read from.
# ---------------------------------------------------------------------------
ARMBIAN_BUILD_REPO="https://github.com/armbian/build"
ARMBIAN_BUILD_REV="5e2fa21ab509e9cf6afb05f3df46c9bd2b0cfa39"   # main @ 2026-08-04
ARMBIAN_BRANCH="vendor"

# Both CeraLive RK3588 boards resolve to the SAME Armbian family AND to the same
# vendor kernel package, so one mapping covers both.
#   config/boards/rock-5b-plus.conf   BOARDFAMILY=rockchip-rk3588  KERNEL_TARGET="vendor,current,edge"
#   config/boards/orangepi5-plus.conf BOARDFAMILY=rockchip-rk3588  KERNEL_TARGET="current,edge,vendor"
ARMBIAN_BOARDS="rock-5b-plus orangepi5-plus"
ARMBIAN_BOARDFAMILY="rockchip-rk3588"

# ---------------------------------------------------------------------------
# Resolved kernel coordinates for BRANCH=vendor.
#
# Resolution chain (all at ARMBIAN_BUILD_REV):
#   1. config/sources/families/rockchip-rk3588.conf sources
#      include/rockchip64_common.inc on line 10, then its OWN `case $BRANCH`
#      handles `legacy` and `vendor`. Unlike `edge`, `vendor` IS handled here —
#      lines 32-42 set every value below explicitly, so the include's arms
#      (current/edge/bleedingedge) never run for this branch.
#   2. rockchip64_common.inc line 24 says so in as many words: "we don't set
#      LINUXFAMILY and LINUXCONFIG -- unless it is current or edge".
#   3. LINUXCONFIG therefore falls through to config/sources/common.conf line 134:
#      LINUXCONFIG="linux-${LINUXFAMILY}-${BRANCH}" => linux-rk35xx-vendor.
#   4. The kernel .deb name comes from lib/functions/compilation/kernel-debs.sh
#      line 72: "linux-image-${BRANCH}-${LINUXFAMILY}" => linux-image-vendor-rk35xx.
# ---------------------------------------------------------------------------
KERNEL_MAJOR_MINOR="6.1"
LINUXFAMILY="rk35xx"
LINUXCONFIG="linux-rk35xx-vendor"

# Armbian's kernel config source for this branch.
KERNEL_CONFIG_SOURCE="config/kernel/linux-rk35xx-vendor.config"

# Armbian's own patch directory for this kernel family. NOTE: this one is a
# TOP-LEVEL patch/kernel/ directory, not under patch/kernel/archive/ the way the
# mainline rockchip64-* families are. The userpatches counterpart mirrors it —
# see lib/functions/artifacts/artifact-kernel.sh line 95,
# "${USERPATCHES_PATH}/kernel/${KERNELPATCHDIR}".
KERNELPATCHDIR="rk35xx-vendor-6.1"
KERNEL_PATCHDIR="patch/kernel/rk35xx-vendor-6.1"
KERNEL_USERPATCHDIR="userpatches/kernel/rk35xx-vendor-6.1"

# The Debian package the shipped CeraLive image installs today.
KERNEL_DEB_PACKAGE="linux-image-vendor-rk35xx"
KERNEL_VERSION="6.1.115"

KERNELSOURCE="https://github.com/armbian/linux-rockchip.git"

# What Armbian ACTUALLY uses: a rolling BSP branch, not a fixed tag or commit.
KERNELBRANCH_ARMBIAN="branch:rk-6.1-rkr5.1"
KERNEL_BRANCH="rk-6.1-rkr5.1"

# What WE pin. `rk-6.1-rkr5.1` moves under us, and the BSP publishes no tags on
# it, so this repo pins an exact COMMIT rather than a tag. This one was chosen
# because its commit timestamp matches the running CeraLive board's kernel build
# timestamp to the second — see docs/PREFLIGHT.md.
KERNEL_COMMIT="95e85f6cb496c75807c5b16f158853578e7e7d1b"
KERNEL_COMMIT_DATE="2026-06-14T17:47:08Z"
KERNEL_COMMIT_SUBJECT="ata: ahci: force 32-bit DMA for JMicron JMB582/JMB585 (#504)"

# Same repo; named separately so a mirror can be substituted in CI without
# touching the semantic KERNELSOURCE value above.
KERNEL_MIRROR="https://github.com/armbian/linux-rockchip.git"

# NOT our branch. rk-6.1-rkr6.1 is a genuinely different, diverged BSP branch
# (introduced later, produces 6.1.118). preflight.sh asserts the vendor mapping
# does NOT resolve to it, because a silent switch would move us off 6.1.115.
KERNELBRANCH_NOT="rk-6.1-rkr6.1"

# ---------------------------------------------------------------------------
# The regression this series fixes.
# ---------------------------------------------------------------------------
REGRESSION_COMMIT="78c67d98f221895336d41d8799b38eff6b6b7b4e"
REGRESSION_PR="430"
REGRESSION_SUBJECT="ASoC: hdmi-codec: disable capture for HDMI-TX to fix mono audio"

# ---------------------------------------------------------------------------
# Patch source: an UNMERGED pull request against armbian/linux-rockchip.
#
# The PR is pinned by COMMIT SHA, never by `refs/pull/487/head`. A force-push or
# rebase of the PR branch changes what that ref points at; it cannot change what
# these two SHAs contain. See docs/PROVENANCE.md §3.
# ---------------------------------------------------------------------------
UPSTREAM_PATCHES_REPO="https://github.com/armbian/linux-rockchip"
UPSTREAM_PATCHES_PR="487"
UPSTREAM_PATCHES_PR_URL="https://github.com/armbian/linux-rockchip/pull/487"
UPSTREAM_PATCHES_PR_BASE="rk-6.1-rkr5.1"
UPSTREAM_PATCHES_PR_AUTHOR="smazurov"
# PR state at import. preflight.sh re-reads it and reports drift.
UPSTREAM_PATCHES_PR_STATE="open"

# The two backport commits, in apply order.
PATCH_COMMIT_1="e61f83c2a1d6e549be8a37ccc4ee3bd7d5957303"
PATCH_COMMIT_2="2f2652ff988b84db627909eac1e6a4ef644144a2"
# The rk-6.1-rkr5.1 commit the PR branch forked from. 17 commits BEHIND
# KERNEL_COMMIT — the series still applies, which apply.sh proves rather than
# assumes.
PATCH_COMMIT_BASE="9bd271d7fa4aab0cffd2ac6f1fd8e26c857c46c2"

# The mainline Linux commits each backport declares with a "commit <sha>
# upstream." line. verify-payload-parity.py cross-checks these against the
# patch text, so a swapped or re-authored patch file cannot pass silently.
LINUX_COMMIT_1="f77a066f4ed307db93aafee621e2683c3bda98ce"
LINUX_COMMIT_2="e041a2a550582106cba6a7c862c90dfc2ad14492"
